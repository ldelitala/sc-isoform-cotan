// nextflow.config - Unified Configuration for Nextflow Pipeline

env {
    PATH = '/home/lorenzo_delitala/.conda/envs/deli/bin:/opt/conda/bin:$PATH'
}

params {
    // 1. Core Execution Settings
    dataset = ""
    // Dataset name (e.g. manno2021)
    srr_ids = ""
    // Comma-separated SRR IDs or range (e.g. SRR11947578-SRR11947580)
    genome = ""
    // Genome code (e.g. GRCh38 / GRCm38)
    step = "all"
    // 'all', 'download', 'align', 'filter'
    webhook_url = "https://discord.com/api/webhooks/1517487129414865008/NIsEzsL_m62Ll5q1TUCrX_kCsoAIGNALPX-3XGD1BO5o_p8FHnu0xoeJtp-DIsf00Kdc"
    // Discord/Slack webhook for notifications

    // 2. nf-core/scrnaseq Settings Map (Transparent and Customizable)
    scrnaseq_params = [protocol: "10XV3", skip_cellbender: true, simpleaf_umi_resolution: "parsimony-em"]

    // 3. QC Filtering Settings
    min_features = 200
    // Min transcripts detected per cell
    max_features = 8000
    // Max transcripts detected per cell
    min_counts = 500
    // Min UMIs detected per cell
    max_percent_mt = 10.0
    // Max % mitochondrial reads allowed
    mt_transcripts = "config/mt_transcripts.txt"
}

// Global resource allocations for Athena Server (88 Cores, 2.9TB RAM)
executor {
    name = 'local'
    cpus = 80
    memory = 2560.GB
}

process {
    // Set low scheduling priority to the process shell PID ($$) dynamically. Inherited by all child tasks.
    beforeScript = 'renice -n 19 -p $$ && ionice -c 3 -p $$ || true'

    // Safety caps for processes
    resourceLimits = [cpus: 80, memory: 2560.GB]

    // Concurrency controls for specific processes (replaces MAX_PARALLEL_JOBS and THREADS_PER_JOB)
    withName: 'DOWNLOAD_BAM|DOWNLOAD_FASTQ' {
        maxForks = 6
        cpus = 12
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: ALIGN_SIMPLEAF {
        cpus = 72
        memory = 2048.GB
    }

    withName: QC_FILTER {
        cpus = 8
        memory = 100.GB
    }
}

// Container execution settings (Singularity)
singularity {
    enabled = true
    autoMounts = true
    cacheDir = "${projectDir}/cache/singularity"
}
